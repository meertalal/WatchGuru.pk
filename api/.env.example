APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
SITE_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=watchguru
DB_USER=root
DB_PASSWORD=

ADMIN_EMAIL=admin@watchguru.pk
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=Store
ADMIN_LAST_NAME=Manager
ADMIN_PHONE=+923001234567

ADMIN_TOKEN_TTL_DAYS=7
UPLOAD_MAX_SIZE=5242880

# Stock module: a product below this level appears in the low-stock queue.
STOCK_LOW_THRESHOLD=5

# Throttle public endpoints (login, checkout, newsletter, contact, warranty).
RATE_LIMIT_ENABLED=true

# Outbound email (SMTP). Gmail requires a 16-character App Password.
# Leave MAIL_ENABLED=false to disable sending locally.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=you@example.com
MAIL_PASSWORD="your-app-password"
MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME="WatchGuru.pk"
MAIL_STORE_ADDRESS=concierge@watchguru.pk
MAIL_TIMEOUT=12
